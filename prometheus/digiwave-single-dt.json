        "name": "da_id",
        "options": [],
        "query": {
          "query": "label_values(dw_core_da_state_update_processing_exec_success_count_total{dt_id=\"$dt_id\"}, da_id)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query"
      }
    ]
