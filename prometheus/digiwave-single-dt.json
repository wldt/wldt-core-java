  "panels": [

    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "color": "gray",             "index": 0, "text": "NONE"             },
                "1": { "color": "red",              "index": 1, "text": "DESTROYED"        },
                "2": { "color": "dark-red",         "index": 2, "text": "STOPPED"          },
                "3": { "color": "yellow",           "index": 3, "text": "CREATED"          },
                "4": { "color": "super-light-yellow","index": 4, "text": "STARTED"         },
                "5": { "color": "orange",           "index": 5, "text": "UN_BOUND"         },
                "6": { "color": "semi-dark-orange", "index": 6, "text": "NOT_SYNCHRONIZED" },
                "7": { "color": "light-green",      "index": 7, "text": "BOUND"            },
                "8": { "color": "green",            "index": 8, "text": "SYNCHRONIZED"     }
              }
            }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "unit": "none",
          "min": 0,
          "max": 8,
          "noValue": "0"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "max by (dt_id) (last_over_time(dw_core_dt_lifecycle_value{dt_id=\"$dt_id\"}[$staleness]))",
          "legendFormat": "Lifecycle",
          "interval": "1s",
          "refId": "A"
        }
      ],
      "title": "DT Lifecycle State",
      "type": "stat"
    },

    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "unit": "ops",
          "noValue": "0"
        },
