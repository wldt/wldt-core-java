    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "Data Source",
        "multi": false,
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "type": "datasource"
      },
      {
        "current": { "selected": true, "text": "1s", "value": "1s" },
        "hide": 0,
        "includeAll": false,
        "label": "Staleness Threshold",
        "multi": false,
        "name": "staleness",
        "options": [
          { "selected": false, "text": "1s",  "value": "1s"  },
          { "selected": false, "text": "10s", "value": "10s" },
          { "selected": false, "text": "30s", "value": "30s" },
          { "selected": false, "text": "1m",  "value": "1m"  },
          { "selected": true,  "text": "5m",  "value": "5m"  },
          { "selected": false, "text": "15m", "value": "15m" },
          { "selected": false, "text": "1h",  "value": "1h"  },
          { "selected": false, "text": "6h",  "value": "6h"  }
        ],
        "query": "1s,10s,30s,1m,5m,15m,1h,6h",
        "skipUrlSync": false,
        "type": "custom"
      },
      {
        "current": {},
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "definition": "label_values(dw_core_pt_property_variation_exec_success_count_total, dt_id)",
        "hide": 0,
        "includeAll": false,
        "label": "Digital Twin ID",
        "multi": false,
        "name": "dt_id",
        "options": [],
        "query": {
          "query": "label_values(dw_core_pt_property_variation_exec_success_count_total, dt_id)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query"
      },
      {
        "current": {},
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "definition": "label_values(dw_core_pa_property_event_pub_success_count_total{dt_id=\"$dt_id\"}, pa_id)",
        "hide": 0,
        "includeAll": true,
        "allValue": ".*",
        "label": "Physical Adapter ID",
        "multi": true,
        "name": "pa_id",
        "options": [],
        "query": {
          "query": "label_values(dw_core_pa_property_event_pub_success_count_total{dt_id=\"$dt_id\"}, pa_id)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query"
      },
      {
        "current": {},
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
